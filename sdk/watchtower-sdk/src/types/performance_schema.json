{
  "required": ["event_type", "timestamp", "payload"],
  "properties": {
    "event_type": { "type": "string", "const": "performance" },
    "timestamp": { "type": "string", "format": "date-time" },

    "payload": {
      "name": { "type": "string" },
      "entryType": { "type": "string" },
      "time": { "type": "number" },
      "duration": { "type": "number" },
      "oneOf": [
        { "$ref": "#/definitions/ResourcePayload" },
        { "$ref": "#/definitions/NavigationPayload" }
      ]
    }
  },

  "definitions": {

    "ResourcePayload": {
      "allOf": [
        { "$ref": "#/definitions/BasePayload" },
        {
          "type": "object",
          "properties": {
            "entryType": { "type": "string", "const": "resource" },
            "secureConnectionStart": { "type": "number" },
            "connectStart": { "type": "number" },
            "connectEnd": { "type": "number" },
            "domainLookupStart": { "type": "number" },
            "domainLookupEnd": { "type": "number" },
            "redirectStart": { "type": "number" },
            "redirectEnd": { "type": "number" },
            "workerStart": { "type": "number" },
            "fetchStart": { "type": "number" },
            "requestStart": { "type": "number" },
            "responseStart": { "type": "number" },
            "responseEnd": { "type": "number" },
            "firstInterimResponseStart": { "type": "number" },
            "finalResponseHeadersStart": { "type": "number" },
            "contentType": { "type": "string" },
            "deliveryType": { "type": "string" },
            "initiatorType": { "type": "string" },
            "nextHopProtocol": { "type": "string" },
            "renderBlockingStatus": { "type": "string" },
            "responseStatus": { "type": "number" },
            "transferSize": { "type": "number" }
          }
        }
      ]
    },

    "NavigationPayload": {
      "allOf": [
        { "$ref": "#/definitions/BasePayload" },
        {
          "type": "object",
          "properties": {
            "entryType": { "type": "string", "const": "navigation" },
            "initiatorType": { "type": "string" },
            "activationStart": { "type": "number" },
            "confidence": { "type": "string" },
            "criticalCHRestart": { "type": "number" },
            "domComplete": { "type": "number" },
            "domContentLoadedEventStart": { "type": "number" },
            "domContentLoadedEventEnd": { "type": "number" },
            "loadEventStart": { "type": "number" },
            "loadEventEnd": { "type": "number" },
            "domInteractive": { "type": "number" },
            "notRestoredReasons": { "type": ["object", "null"] },
            "redirectCount": { "type": "number" },
            "type": {
              "type": "string",
              "enum": ["navigate", "reload", "back_forward"]
            },
            "unloadEventStart": { "type": "number" },
            "unloadEventEnd": { "type": "number" }
          }
        }
      ]
    }
  }
}