{
  "type": "object",
  "properties": {
    "api_key": { "type": "string" },
    "service": { "type": "string" },
    "environment": { "type": "string" },

    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_type": { "const": "log" },
          "timestamp": { "type": "string", "format": "date-time" },
          "payload": {
            "type": "object",
            "properties": {
              "level": { "type": "string" },
              "message": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["level", "message", "timestamp"]
          }
        },
        "required": ["event_type", "timestamp", "payload"]
      }
    }
  },
  "required": ["api_key", "service", "environment", "events"]
}
