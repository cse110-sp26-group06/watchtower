{
  "type": "object",
  "properties": {
    "event_type": { "const": "span" },
    "timestamp": { "type": "string", "format": "date-time" },
    "api_key": { "type": "string" },
    "service": { "type": "string" },
    "environment": { "type": "string" },

    "payload": {
      "type": "object",
      "properties": {
        "span_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "name": { "type": "string" },
        "start_timestamp": { "type": "string", "format": "date-time" },
        "end_timestamp": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "number" }
      },
      "required": ["name", "start_timestamp", "end_timestamp", "duration_ms"]
    }
  },
  "required": ["event_type", "timestamp", "api_key", "service", "environment", "payload"]
}
